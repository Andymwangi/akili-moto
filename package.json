{
  "name": "neno-word-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && tsx scripts/check-bundle-leaks.ts",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply neno-local --local",
    "db:seed:local": "wrangler d1 execute neno-local --local --file=test/fixtures/seed-local.sql",
    "cf:types": "wrangler types",
    "deploy:dry": "wrangler deploy --dry-run",
    "validate:wordlists": "tsx scripts/validate-wordlists.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "5.105.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/vitest-plugin": "1.4.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.0",
    "wrangler": "4.156.1"
  }
}
